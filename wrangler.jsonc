{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hitchhikers-ai",
	"compatibility_date": "2025-02-04",
	// @astrojs/cloudflare 14 (Astro 7) builds via a unified entrypoint module
	// provided by the adapter instead of emitting dist/_worker.js/index.js.
	// See https://docs.astro.build/en/guides/integrations-guide/cloudflare/
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "dist"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI",
		// Inference has no local emulation, so dev talks to the real Workers AI.
		// KV stays local, so dev never touches production article data.
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "TOKEN_USAGE",
			"id": "2da1bbe02c284aa4956e377a0d35b712"
		},
		{
			"binding": "ARTICLES",
			"id": "feafac9d860c4adcb732576d3a0549ab"
		},
		{
			"binding": "SEARCHES",
			"id": "21df91c40fca483aadb58a56e8e03d3e"
		},
		{
			"binding": "INDICES",
			"id": "4c98f53cf22241e6964f1f2e3231811b"
		}
	]
}